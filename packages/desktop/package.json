{
  "name": "@tadori/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "tadori のデスクトップアプリ（Tauri の窓から tadori serve を起こして映す）",
  "scripts": {
    "tauri": "tauri",
    "dev": "pnpm --filter @tadori/cli... build && tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
