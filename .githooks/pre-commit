#!/usr/bin/env bash
# commit の前に、置き場所の検査・個人や委託先の名前の検査・型の検査・テストを走らせる。
# 有効にするには（このリポジトリで 1 回だけ）: git config core.hooksPath .githooks
set -euo pipefail
bash .github/scripts/oss-placement-check.sh
OSS_DENY_WORDS="${OSS_DENY_WORDS:-$(bash .githooks/deny-words.sh)}" bash .github/scripts/oss-privacy-check.sh
pnpm -s verify
